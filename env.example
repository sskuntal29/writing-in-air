# ─────────────────────────────────────────────────────────────────
# writing-in-air — Environment Configuration
# Copy this file to .env and fill in your local values.
# .env is gitignored and should NEVER be committed.
# ─────────────────────────────────────────────────────────────────

# ── DATASET PATHS ────────────────────────────────────────────────

# Folder containing your raw .zip dataset files
# Windows example: I:\SAGAR\dataset
# Linux/Mac example: /home/user/datasets/air-writing
ZIP_DIR=I:\SAGAR\dataset

# Destination folder where zips will be extracted
DATASET_DIR=I:\SAGAR\dataset_extracted

# ── CHECKPOINTS ──────────────────────────────────────────────────

# Directory to save model checkpoints
SAVE_DIR=I:\SAGAR\checkpoints

# Path to a specific checkpoint folder to resume training from.
# Leave blank to train from scratch.
# Example: I:\SAGAR\checkpoints\r3d_local_eng\models\weights_49_best
LOAD_DIR=

# ── MODEL ────────────────────────────────────────────────────────

# Encoder architecture: r3d | mc3 | rmc3 | twoplusone | r2d
MODEL_TYPE=r3d

# Sequence decoder: none | lstm | gru | transformers
RECURRENT_TYPE=none

# Language mode: english | korean | eng_kor
DATA_TYPE=english

# ── TRAINING ─────────────────────────────────────────────────────

# Batch size — reduce to 1 if you get CUDA out-of-memory errors
BATCH_SIZE=2

# Learning rate
LEARNING_RATE=1e-3

# Number of training epochs (use 50 for quick runs, 175 for full)
NUM_EPOCHS=175

# Optimizer: adam | adamW | sgd | rmsprop | lamb
OPTIMIZER_TYPE=adam

# LR scheduler: warmup | steplr | none
SCHEDULER_TYPE=warmup

# ── SYSTEM ───────────────────────────────────────────────────────

# Number of DataLoader worker processes.
# Keep at 0 on Windows to avoid multiprocessing spawn errors.
NUM_WORKERS=0

# Set to true to disable CUDA and force CPU (not recommended)
NO_CUDA=false

# ── EXPERIMENT ───────────────────────────────────────────────────

# Name for this training run (used for checkpoint subfolder name)
MODEL_NAME=wita-resnet3d

# Random seed for reproducibility
SEED=0
